{
  "name": "eslint-plugin-belgradian",
  "version": "2.1.0",
  "description": "Eslint plugin for extending the camel case rule by allowing hungarian style variable names",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git@github.com:proctorio/eslint-plugin-belgradian.js.git"
  },
  "scripts": {
    "build-windows": "xcopy src lib /E /I /Y",
    "build-linux": "cp -R src lib",
    "test": "vitest run --coverage",
    "lint": "eslint --ext js --fix src/ test/"
  },
  "author": "Proctorio",
  "license": "MIT",
  "dependencies": {
    "camelcase": "^6.2.0",
    "lodash.get": "^4.4.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.0.0",
    "globals": "^17.4.0",
    "vitest": "3.2.4"
  }
}
