{
  "name": "eslint-plugin-belgradian",
  "version": "2.1.0",
  "description": "Eslint plugin for extending the camel case rule by allowing hungarian style variable names",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proctorio/eslint-plugin-belgradian.js.git"
  },
  "scripts": {
    "build-windows": "xcopy src lib /E /I /Y",
    "build-linux": "cp -R src lib",
    "test": "vitest run --coverage",
    "lint": "eslint --ext js --fix src/ test/"
  },
  "author": "Proctorio",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "vitest": "5.0.0"
  }
}
