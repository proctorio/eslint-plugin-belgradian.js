{
  "name": "eslint-plugin-belgradian",
  "version": "3.0.0",
  "description": "ESLint plugin for enforcing Hungarian notation with camelCase variable naming conventions",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "hungarian-notation",
    "naming-convention",
    "camelcase",
    "code-style"
  ],
  "author": "Proctorio <hello@proctorio.com> (https://proctorio.com)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/proctorio/eslint-plugin-belgradian.js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proctorio/eslint-plugin-belgradian.js.git"
  },
  "bugs": {
    "url": "https://github.com/proctorio/eslint-plugin-belgradian.js/issues"
  },
  "main": "lib/index.js",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node -e \"require('fs').cpSync('src', 'lib', {recursive: true})\"",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "engines": {
    "node": ">=16.7.0"
  },
  "peerDependencies": {
    "eslint": ">=7.0.0"
  },
  "devDependencies": {
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "jest-junit": "16.0.0"
  }
}
